  {
    "id": "rules",
    "face": "corner",
    "dur": 24.67,
    "talk": 24.67,
    "media": "pitch-vo/rules.mp3",
    "video": false,
    "trim": 0,
    "segments": null,
    "lead": 0.35,
    "lines": [
      {
        "t": "Here's how a raid plays.",
        "start": 0.35,
        "end": 1.71
      },
      {
        "t": "A sponsor puts up a wall and a prize.",
        "start": 1.93,
        "end": 4.49
      },
      {
        "t": "For about a minute, every seat taps HIT. Each hit buys from the wall.",
        "start": 4.71,
        "end": 8.66
      },
      {
        "t": "The last stretch is the danger zone: the raid can end on any block in there.",
        "start": 8.88,
        "end": 12.74
      },
      {
        "t": "Pyth draws the end block. Hits before it count. Hits after it don't.",
        "start": 12.96,
        "end": 17.14
      },
      {
        "t": "Hit the target, the wall breaks and the seats split the prize.",
        "start": 17.36,
        "end": 20.36
      },
      {
        "t": "Miss it, and the prize rolls into the sponsor's next raid.",
        "start": 20.58,
        "end": 24.12
      }
    ],
    "cues": [
      0.35,
      1.93,
      4.71,
      8.88,
      12.96,
