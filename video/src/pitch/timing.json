    "trim": 0,
    "segments": null,
    "lead": 0.12,
    "lines": [
      {
        "t": "We built it on Monad because a raid only feels like a game when blocks are fast.",
        "start": 0.12,
        "end": 3.74
      },
      {
        "t": "Kuru gives us a real on-chain order book, so the wall is real liquidity, not a mock.",
        "start": 3.8,
        "end": 8.11
      },
      {
        "t": "And Pyth Entropy gives us a fair end that nobody, not even us, can know in advance.",
        "start": 8.17,
        "end": 13.06
      }
