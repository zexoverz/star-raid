    ]
  },
  {
    "id": "how",
    "face": "corner",
    "dur": 33.99,
    "talk": 33.99,
    "media": "pitch-vo/how.mp3",
    "video": false,
    "trim": 0,
    "segments": null,
    "lead": 0.35,
    "lines": [
      {
        "t": "Under the hood, every hit is a buy on Kuru's order book on Monad, capped at the wall price.",
        "start": 0.35,
        "end": 6.16
      },
      {
        "t": "Cheaper asks fill first, and anything left over is cancelled and refunded in the same transaction.",
        "start": 6.38,
        "end": 12.57
      },
      {
        "t": "The end of the raid is drawn by Pyth Entropy after the window closes, so nobody can snipe the last block.",
        "start": 12.79,
        "end": 19.65
      },
      {
        "t": "And only seats count.",
        "start": 19.87,
        "end": 21.75
      },
      {
        "t": "A wallet without a Lil Star can still buy, but it earns nothing.",
        "start": 21.97,
        "end": 25.59
      },
      {
        "t": "On testnet, raid #26 broke its wall: 58 hits, 580 counted against a 500 target.",
        "start": 25.81,
        "end": 33.44
      }
    ],
    "cues": [
      0.35,
      6.38,
      12.79,
      19.87,
      21.97,
      25.81
    ]
  },
  {
    "id": "why",
    "face": "full",
