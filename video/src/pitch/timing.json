    "segments": null,
    "lead": 0.35,
    "lines": [
      {
        "t": "This is the lobby. The next raid, live, right here on your phone.",
        "start": 0.35,
        "end": 4.62
      },
      {
        "t": "A sponsor sets the wall, the price cap and a USDC prize, and posts it in a few taps.",
        "start": 4.84,
        "end": 10.75
      },
      {
        "t": "Your Lil Star is your seat. One Star, one seat. That's the whole bot defence.",
        "start": 10.97,
        "end": 16.05
      },
      {
        "t": "Set up once, and every raid after that is one tap. No wallet popups.",
        "start": 16.27,
        "end": 20.95
      },
      {
        "t": "When the window opens, everyone hits the wall. Every hit is a real buy.",
        "start": 21.17,
        "end": 25.61
      },
      {
        "t": "Then the end block is drawn, every hit is checked, and if the seats hit the target, the wall breaks.",
        "start": 25.83,
        "end": 31.98
      }
    ],
    "cues": [
