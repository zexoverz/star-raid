# Live SSE service (public). Defaults to the hosted testnet one.
VITE_LIVE_URL=https://live-production-e50b.up.railway.app
# Monad testnet RPC for the wallet's own reads and writes.
VITE_RPC_URL=https://testnet-rpc.monad.xyz
# Reown AppKit project id (dashboard.reown.com; the team uses the same one as KERB). Injected wallets work without it; WalletConnect needs it.
VITE_REOWN_PROJECT_ID=
# Keeper on-demand endpoint (testnet). POST /demo starts a test raid now.
VITE_KEEPER_URL=https://keeper-production-23ee.up.railway.app
